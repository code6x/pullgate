# Starts pullgate-update.service once a day. It sends a notice for each
# new release that passed its checks; it installs nothing without /update
# and a tap. [updates] check = false in listener.toml stops the notices.
[Unit]
Description=pullgate update: look for a new release once a day

[Timer]
OnBootSec=10min
OnCalendar=daily
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
