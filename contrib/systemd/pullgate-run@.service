# pullgate run NAME: fetch, check, and ask (DESIGN.md section 7).
# Started by pullgate-run@NAME.timer. Runs as root, because root owns the
# clone (rule 6). check and summary run as check_user inside this sandbox.
[Unit]
Description=pullgate run for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pullgate run %i
SyslogIdentifier=pullgate
UMask=0077
TimeoutStartSec=30min
# When the run ends, systemd stops every process left in its cgroup,
# including a check that left its process group (DESIGN.md section 11).
KillMode=control-group

# Sandbox. Root needs: CAP_SETUID/CAP_SETGID to run check as check_user,
# CAP_CHOWN/CAP_FOWNER to fix the spool owners, CAP_DAC_OVERRIDE to remove
# files in the listener's inbox.
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/pullgate /var/spool/pullgate
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# @system-service has @setuid and @chown, which check_user and the spool
# need, so @privileged is not taken out here.
SystemCallFilter=@system-service
SystemCallFilter=~@resources @mount @swap @reboot @module @raw-io @clock @debug @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
DevicePolicy=closed
